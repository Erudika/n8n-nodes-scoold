{
    "name": "@erudika/n8n-nodes-scoold",
    "version": "0.5.0",
    "description": "n8n community node for Scoold — search extraction and webhook-based event triggers",
    "license": "MIT",
    "homepage": "https://github.com/Erudika/n8n-nodes-scoold",
    "keywords": [
        "n8n-community-node-package",
        "scoold",
        "n8n-nodes-scoold",
        "questions-and-answers"
    ],
    "author": {
        "name": "Alex Bogdanovski",
        "email": "alex@erudika.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Erudika/n8n-nodes-scoold.git"
    },
    "publishConfig": {
        "provenance": true
    },
    "scripts": {
        "build": "n8n-node build",
        "build:watch": "tsc --watch",
        "dev": "n8n-node dev",
        "lint": "n8n-node lint",
        "lint:fix": "n8n-node lint --fix",
        "release": "n8n-node release",
        "prepublishOnly": "n8n-node prerelease",
        "version": "auto-changelog -p && git add CHANGELOG.md"
    },
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": true,
        "credentials": [
            "dist/credentials/ScooldApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/Scoold/Scoold.node.js",
            "dist/nodes/ScooldTrigger/ScooldTrigger.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "^0.44.1",
        "auto-changelog": "^2.6.0",
        "eslint": "^9.29.0",
        "prettier": "^3.9.6",
        "release-it": "^21.0.2",
        "typescript": "^6.0.3"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    }
}
